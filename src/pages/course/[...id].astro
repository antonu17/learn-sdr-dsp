---
import {getCollection,render} from 'astro:content';
import Course from '../../layouts/Course.astro';
export async function getStaticPaths(){return (await getCollection('course')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<Course title={entry.data.title} description={entry.data.description} kind={entry.data.kind} headings={headings}><Content/></Course>
